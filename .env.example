# MarkAnchor Environment Configuration
LLM_MODE=mock
# Options: mock | gemini | ollama

# If using Gemini
GEMINI_API_KEY=

# If using Ollama
OLLAMA_URL=http://localhost:11434

# Security
SECRET_KEY=markanchor-super-secret-key-for-dev-demo-2026
DATABASE_URL=sqlite:///./markanchor.db

# OCR Path (Optional on Windows if installed in default path)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Testing
AI_OFFLINE_OVERRIDE=false

# Phase A: Assignment 2-minute correction window
CORRECTION_WINDOW_SECONDS=120

# Phase B: Verifier settings for Math & Alternate Methods
VERIFIER_MODE=mock
VERIFIER_MODEL=gemini-2.5-flash

# Phase C: Groq & Secondary LLM for Cross-Checking (detects off-topic / administrative forms)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CROSS_CHECK_LLM=auto
